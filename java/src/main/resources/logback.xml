<configuration>
    <!-- Structured JSON logs (plan.md criterion #8), same as the other stacks'
         JSON log lines. logstash-logback-encoder writes one JSON object per line. -->
    <appender name="json" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
    </appender>

    <root level="INFO">
        <appender-ref ref="json"/>
    </root>

    <!-- Jetty/Javalin startup chatter is noisy; keep it at WARN. -->
    <logger name="org.eclipse.jetty" level="WARN"/>
    <logger name="io.javalin.Javalin" level="WARN"/>
</configuration>
