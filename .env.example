# Shared env vars, same values used by both stacks (plan.md criterion #9).
# Copy to .env in each stack's directory (ballerina/.env, go/.env) and fill in.

PORT=8080
DB_PATH=./blog.db
JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRY=24h
PROFANITY_URL=http://localhost:9090
PROFANITY_TIMEOUT=2s
