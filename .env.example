# Shared env vars, same values used by all stacks (plan.md criterion #9).
# Copy to .env in each stack's directory (ballerina/.env, go/.env, ...) and
# fill in. PORT differs per stack when running more than one at once:
# go=8080, ballerina=8081, python=8082, node=8083, bun=8084, rust=8085,
# java=8086.

PORT=8080
DB_PATH=./blog.db
JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRY=24h
PROFANITY_URL=http://localhost:9090
PROFANITY_TIMEOUT=2s
